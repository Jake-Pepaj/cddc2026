cat > /root/backup.sh <<'EOF'
#!/bin/bash
TS=$(date +%Y%m%d-%H%M%S)
DEST=/root/backups
mkdir -p "$DEST" && chmod 700 "$DEST"
OUT="$DEST/webserver-$TS.tar.gz"

tar czpf "$OUT" \
  /var/www \
  /etc/apache2 /etc/nginx /etc/httpd \
  /etc/ssh \
  /etc/passwd /etc/group /etc/shadow /etc/sudoers /etc/sudoers.d \
  /etc/crontab /etc/cron.d \
  /etc/ufw \
  /root/.ssh /home/*/.ssh \
  2>/dev/null

if command -v mysqldump >/dev/null 2>&1; then
  mysqldump --all-databases > "$DEST/db-$TS.sql" 2>/dev/null
fi

chmod 600 "$DEST"/*
sha256sum "$OUT" > "$OUT.sha256"
echo "Backup saved: $OUT"
ls -lh "$DEST"
EOF
chmod +x /root/backup.sh && /root/backup.sh
